# Real backend (turf-api). Relative, so browser calls go through the Next.js proxy.
NEXT_PUBLIC_API_URL=/api/v1
# Where turf-api runs — server-side only (used by the rewrite and Server Components)
API_PROXY_TARGET=http://localhost:4000
# Legacy mock Express server (server/) for pages turf-api doesn't serve yet
NEXT_PUBLIC_APP_NAME=Turf
