{
  "name": "turforg",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace turf-admin dev",
    "dev:saas": "yarn workspace @turforg/saas dev",
    "build": "yarn workspace turf-admin build && yarn workspace @turforg/saas build",
    "start": "yarn workspace turf-admin start",
    "start:saas": "yarn workspace @turforg/saas start",
    "lint": "eslint apps/operations/src apps/saas/src packages/web-shared/src",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test:booking-requests": "yarn workspace turf-admin test:booking-requests",
    "test:platform-navigation": "yarn workspace turf-admin test:platform-navigation",
    "test:platform-billing": "yarn workspace turf-admin test:platform-billing"
  },
  "devDependencies": {
    "eslint": "^9.11.1",
    "eslint-config-next": "^16.2.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.6.2"
  }
}
