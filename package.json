{
  "name": "turfops",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @turforg/portal dev",
    "dev:saas": "yarn workspace @turforg/saas dev",
    "build": "yarn workspace @turforg/portal build && yarn workspace @turforg/saas build && yarn workspace @turforg/platform build && yarn workspace @turforg/admin build",
    "start": "yarn workspace @turforg/portal start",
    "start:saas": "yarn workspace @turforg/saas start",
    "lint": "eslint apps/admin/src apps/portal/src apps/saas/src apps/platform/src packages/web-shared/src",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test:booking-requests": "yarn workspace @turforg/portal test:booking-requests",
    "test:platform-navigation": "yarn workspace @turforg/platform test:platform-navigation && yarn workspace @turforg/portal test:portal-navigation",
    "test:platform-billing": "yarn workspace @turforg/platform test:platform-billing",
    "dev:platform": "yarn workspace @turforg/platform dev",
    "start:platform": "yarn workspace @turforg/platform start",
    "dev:portal": "yarn workspace @turforg/portal dev",
    "dev:admin": "yarn workspace @turforg/admin dev",
    "start:portal": "yarn workspace @turforg/portal start",
    "start:admin": "yarn workspace @turforg/admin start"
  },
  "devDependencies": {
    "eslint": "^9.11.1",
    "eslint-config-next": "^16.2.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.6.2"
  }
}
